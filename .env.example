HOST=localhost
PORT=25565
VERSION=1.8.9

# Provide exactly one of these.
REFRESH_TOKEN=
ACCESS_TOKEN=

# Or, on an offline-mode server, just a name:
# OFFLINE_USERNAME=Bot

# Chat commands sent after spawning, separated by ";"
# JOIN_COMMANDS=/ac grim;/warp scaffold

# Planner worker threads (0 = plan on the main thread) and the navview mod port (0 = off)
# NAV_WORKERS=2
# DEBUG_PORT=28765
